generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  active
  suspended
  revoked
}

enum MemberRole {
  owner
  admin
  editor
  viewer
}

enum InstallationStatus {
  pending
  active
  revoked
  error
}

enum ContactSyncStatus {
  local_only
  synced
  pending
  conflict
  failed
}

enum SyncDirection {
  import
  export
}

enum JobStatus {
  pending
  running
  completed
  partially_failed
  failed
}

/// Estado de la configuración automática (aprovisionamiento). Independiente de la instalación y de la sincronización.
enum ConfigurationStatus {
  pending
  running
  ready
  requires_action
  cancelled
}

enum ProvisioningStepStatus {
  pending
  running
  succeeded
  failed
  requires_action
  ambiguous
  cancelled
}

/// Origen de un recurso remoto registrado: creado por esta app o adoptado (ya existía en la location).
enum ResourceOrigin {
  created
  adopted
}

/// Empresa local = representación interna de UNA subcuenta (location) de GHL. No es la agencia GHL ni un
/// Business del CRM. Una empresa se vincula como máximo a una location (ghlLocationId único).
/// `name` es nulo cuando la empresa se registró automáticamente y el nombre no pudo verificarse con GHL.
model Company {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String?
  ghlLocationId          String?                 @unique
  status                 EntityStatus            @default(active)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  memberships            Membership[]
  installation           GhlInstallation?
  contacts               Contact[]
  syncJobs               SyncJob[]
  auditLogs              AuditLog[]
  sessions               Session[]
  provisioningExecutions ProvisioningExecution[]
  provisionedResources   ProvisionedResource[]
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  displayName  String
  /// scrypt "salt:hash"; nulo si el usuario sólo accede vía contexto firmado de GHL.
  passwordHash String?
  ghlUserId    String?      @unique
  status       EntityStatus @default(active)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  auditLogs    AuditLog[]
  sessions     Session[]
}

model Membership {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  companyId String       @db.Uuid
  role      MemberRole   @default(viewer)
  status    EntityStatus @default(active)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, status])
}

/// Sesión propia de la aplicación. El JWT sólo transporta el id de sesión; revocar la fila invalida el JWT.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  companyId  String    @db.Uuid
  method     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// Instalación de la app en una location. `ghlCompanyId` es el id de la AGENCIA GHL (no el id interno de Company).
model GhlInstallation {
  id                     String                  @id @default(uuid()) @db.Uuid
  companyId              String                  @unique @db.Uuid
  ghlLocationId          String                  @unique
  ghlCompanyId           String?
  installationStatus     InstallationStatus      @default(pending)
  grantedScopes          String[]
  installedAt            DateTime?
  revokedAt              DateTime?
  lastCommunicationAt    DateTime?
  /// Último error sanitizado (código, nunca cuerpos de respuesta ni tokens).
  lastErrorCode          String?
  /// Se incrementa en cada reinstalación tras una baja: los trabajos de una generación anterior no se ejecutan.
  generation             Int                     @default(1)
  /// app_oauth (iniciada desde Contact Sync con state) | marketplace (callback sin state) | agency (token de agencia).
  installSource          String                  @default("app_oauth")
  /// Presente si el token de location se obtiene desde un token de agencia (POST /oauth/locationToken).
  agencyGrantId          String?                 @db.Uuid
  /// Copia del estado autoritativo de la última ejecución de configuración.
  configurationStatus    ConfigurationStatus     @default(pending)
  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  credential             OAuthCredential?
  agencyGrant            GhlAgencyGrant?         @relation(fields: [agencyGrantId], references: [id], onDelete: SetNull)
  provisioningExecutions ProvisioningExecution[]

  @@index([agencyGrantId])
}

/// Autorización a nivel AGENCIA (token userType=Company). Sólo se usa para obtener tokens de las locations
/// donde la app está instalada; nunca concede acceso a locations no autorizadas.
model GhlAgencyGrant {
  id                    String            @id @default(uuid()) @db.Uuid
  ghlCompanyId          String            @unique
  /// active | revoked | error
  status                String            @default("active")
  grantedScopes         String[]
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  expiresAt             DateTime?
  tokenVersion          Int               @default(1)
  lastErrorCode         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  installations         GhlInstallation[]
}

/// Tokens OAuth cifrados con AES-256-GCM. La clave vive fuera de la base (TOKEN_ENCRYPTION_KEY).
model OAuthCredential {
  id                    String          @id @default(uuid()) @db.Uuid
  installationId        String          @unique @db.Uuid
  encryptedAccessToken  String
  /// Nulo para tokens de location obtenidos desde un token de agencia (no incluyen refresh token).
  encryptedRefreshToken String?
  expiresAt             DateTime
  tokenVersion          Int             @default(1)
  updatedAt             DateTime        @updatedAt
  installation          GhlInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
}

/// State OAuth de un solo uso. Sólo se guarda el hash SHA-256.
model OAuthState {
  id         String    @id @default(uuid()) @db.Uuid
  stateHash  String    @unique
  companyId  String    @db.Uuid
  userId     String    @db.Uuid
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

/// Protección anti-replay del contexto cifrado de Custom Pages.
model GhlContextGrant {
  id          String   @id @default(uuid()) @db.Uuid
  payloadHash String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

/// Deduplicación de webhooks (GHL reintenta hasta 12 veces).
/// processingStatus: processed | pending (INSTALL recibido antes del token) | ignored.
model GhlWebhookEvent {
  id               String    @id @default(uuid()) @db.Uuid
  bodyHash         String    @unique
  webhookId        String?   @unique
  type             String
  locationId       String?
  ghlCompanyId     String?
  processingStatus String    @default("processed")
  processedAt      DateTime?
  receivedAt       DateTime  @default(now())

  @@index([locationId, type, processingStatus])
}

model Contact {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @db.Uuid
  ghlContactId     String
  firstName        String?
  lastName         String?
  email            String?
  phone            String?
  source           String            @default("ghl")
  /// Quién originó el último valor aceptado: "ghl" (importación) o "local" (edición exportada).
  origin           String            @default("ghl")
  syncStatus       ContactSyncStatus @default(local_only)
  lastSyncedAt     DateTime?
  lastRemoteUpdate DateTime?
  /// Hash de los campos remotos en la última sincronización; detecta cambios remotos aunque GHL no envíe fecha.
  remoteHash       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  syncEvents       SyncEvent[]

  @@unique([companyId, ghlContactId])
  @@index([companyId, lastName, firstName])
  @@index([companyId, email])
  @@index([companyId, syncStatus])
  @@index([companyId, updatedAt])
}

model SyncJob {
  id                String        @id @default(uuid()) @db.Uuid
  companyId         String        @db.Uuid
  requestedById     String?       @db.Uuid
  direction         SyncDirection
  status            JobStatus     @default(pending)
  idempotencyKey    String?
  startedAt         DateTime?
  finishedAt        DateTime?
  totalRecords      Int           @default(0)
  successfulRecords Int           @default(0)
  failedRecords     Int           @default(0)
  errorCode         String?
  createdAt         DateTime      @default(now())
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  events            SyncEvent[]

  @@unique([companyId, idempotencyKey])
  @@index([companyId, createdAt])
}

model SyncEvent {
  id           String   @id @default(uuid()) @db.Uuid
  syncJobId    String   @db.Uuid
  contactId    String?  @db.Uuid
  ghlContactId String?
  operation    String
  status       String
  errorCode    String?
  createdAt    DateTime @default(now())
  syncJob      SyncJob  @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([syncJobId, createdAt])
  @@index([contactId])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  actorId       String?  @db.Uuid
  action        String
  resourceType  String
  resourceId    String?
  /// Metadatos no sensibles (p. ej. nombres de campos modificados, nunca valores ni secretos).
  metadata      Json?
  correlationId String
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([correlationId])
}

/// Ejecución persistente de la configuración automática de una location (cola respaldada por PostgreSQL).
/// Un índice único parcial (ver migración) impide más de una ejecución activa (pending/running) por instalación.
model ProvisioningExecution {
  id                     String              @id @default(uuid()) @db.Uuid
  installationId         String              @db.Uuid
  installationGeneration Int
  companyId              String              @db.Uuid
  ghlLocationId          String
  manifestVersion        Int
  /// oauth_callback | marketplace_install | agency_install | webhook_install | user_retry
  trigger                String
  status                 ConfigurationStatus @default(pending)
  attempts               Int                 @default(0)
  maxAttempts            Int                 @default(6)
  nextAttemptAt          DateTime            @default(now())
  /// Bloqueo temporal (lease) + token de cercado: un trabajador obsoleto no puede escribir resultados.
  lockedBy               String?
  lockedUntil            DateTime?
  leaseToken             Int                 @default(0)
  startedAt              DateTime?
  finishedAt             DateTime?
  lastErrorCode          String?
  missingScopes          String[]
  correlationId          String
  requestedById          String?             @db.Uuid
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  installation           GhlInstallation     @relation(fields: [installationId], references: [id], onDelete: Cascade)
  company                Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps                  ProvisioningStep[]

  @@index([status, nextAttemptAt])
  @@index([companyId, createdAt])
  @@index([installationId, createdAt])
}

model ProvisioningStep {
  id          String                 @id @default(uuid()) @db.Uuid
  executionId String                 @db.Uuid
  resourceKey String
  status      ProvisioningStepStatus @default(pending)
  attempts    Int                    @default(0)
  /// created | adopted | verified | updated | recreated | conflict_* | ambiguous_match | pending_reconciliation | missing_scopes
  outcome     String?
  errorCode   String?
  remoteId    String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  execution   ProvisioningExecution  @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, resourceKey])
}

/// Recurso remoto de GHL registrado para una location. Fuente de los IDs remotos (nunca IDs fijos de otra location).
model ProvisionedResource {
  id               String          @id @default(uuid()) @db.Uuid
  companyId        String          @db.Uuid
  ghlLocationId    String
  resourceKey      String
  resourceType     String
  remoteId         String?
  remoteKey        String?
  remoteName       String?
  manifestVersion  Int
  origin           ResourceOrigin?
  managementPolicy String
  /// missing | creating (intención registrada antes del POST) | pending_reconciliation | active | conflict
  status           String          @default("missing")
  /// Creaciones con resultado ambiguo (timeout/5xx) aún no confirmadas.
  ambiguousCount   Int             @default(0)
  lastVerifiedAt   DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  company          Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([ghlLocationId, resourceKey])
  @@unique([companyId, resourceKey])
}
