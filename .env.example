# El backend lee el .env de la RAÍZ del monorepo (scripts/with-env.mjs). Ver ../.env.example.
# Variables mínimas si se ejecuta de forma aislada:
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://aida:aida_local_only@127.0.0.1:5433/aida_contact_sync?schema=public
JWT_SECRET=replace-with-at-least-32-random-bytes
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
GHL_MODE=mock
FRONTEND_ORIGIN=http://localhost:3000
